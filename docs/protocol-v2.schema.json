      "properties": {
        "version": {
          "type": "string",
          "const": "ntapi.listener.v2"
        },
        "sessionId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "deliveryId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "attemptId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "claimToken": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{16,256}$"
        },
        "generation": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "ackKey": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "outcome": {
          "type": "object",
          "properties": {
            "classification": {
              "type": "string",
              "enum": [
                "success",
                "http_error",
                "uncertain",
                "connection_error",
                "invalid_payload"
              ]
            },
            "status": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 599
                },
                {
                  "type": "null"
                }
              ]
            },
            "durationMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 120000
            },
            "requestBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1048576
            },
            "responseBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65536
            },
            "responseComplete": {
              "type": "boolean"
            },
            "truncated": {
              "type": "boolean"
            },
            "error": {
              "type": "string",
              "enum": [
                "none",
                "timeout",
                "aborted",
                "socket",
                "response_limit",
                "validation"
              ]
            },
            "responseHeaders": {
              "type": "array",
              "prefixItems": [],
              "items": false,
              "maxItems": 0
            },
            "responseBody": {
              "type": "string",
              "const": ""
            }
          },
